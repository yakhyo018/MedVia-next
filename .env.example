# Copy to .env.local. The API (~/Desktop/MedVia) runs on :3000 and allows only http://localhost:4000.
REACT_APP_API_URL=http://localhost:3000
REACT_APP_API_GRAPHQL_URL=http://localhost:3000/graphql
REACT_APP_API_WS=http://localhost:3000
# Google sign-in: the OAuth client id (Web application) — the same value as the API's GOOGLE_CLIENT_ID.
# Empty = no Google button.
REACT_APP_GOOGLE_CLIENT_ID=
